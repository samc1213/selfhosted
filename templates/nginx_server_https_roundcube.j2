server {
    server_name roundcube.samacohen.com;

    client_max_body_size 50M;

    location / {
        proxy_pass http://localhost:8291;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Host $server_name;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
    }
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/roundcube.samacohen.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/roundcube.samacohen.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
