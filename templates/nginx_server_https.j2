server {
    server_name {{ nginx_server_name }}.samacohen.com;

    client_max_body_size 0;
{% if nginx_password | bool %}
    # Tailnet devices skip the password; everyone else needs basic auth.
    satisfy any;
    include snippets/tailnet-only.conf;
    auth_basic "{{ nginx_server_name }}";
    auth_basic_user_file /etc/nginx/htpasswd-{{ nginx_server_name }};
{% elif not (nginx_public | bool) %}
    include snippets/tailnet-only.conf;
{% endif %}
    send_timeout 600s;

    location / {
        proxy_pass http://localhost:{{ nginx_server_local_port }};
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Host $server_name;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_request_buffering off;
        client_body_buffer_size 1024k;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
{% if nginx_public | bool %}
    location /admin {
        include snippets/tailnet-only.conf;
        proxy_pass http://localhost:{{ nginx_server_local_port }};
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
    }
{% endif %}
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/{{ nginx_server_name }}.samacohen.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_server_name }}.samacohen.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}