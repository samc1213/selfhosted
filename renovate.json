{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Denver",
  "schedule": ["* 0-8 * * 6"],
  "prConcurrentLimit": 5,
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)files/[^/]+-docker-compose\\.yml$/",
      "/(^|/)roles/mailcow/files/docker-compose\\.override\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Images in Jinja compose templates (not valid YAML, so the docker-compose manager can't parse them)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)files/[^/]+-docker-compose\\.yml\\.j2$/"],
      "matchStrings": ["image:\\s*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"']+)"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "mailcow-dockerized release tag checked out by the mailcow role",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)mail\\.yml$/"],
      "matchStrings": ["mailcow_version:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "mailcow/mailcow-dockerized",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Own images are built from their own repos and tracked by branch tags",
      "matchPackageNames": ["ghcr.io/samc1213/**"],
      "enabled": false
    },
    {
      "description": "Immich bumps its postgres image itself; follow its release notes instead",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "Immich server and ML must move together",
      "matchPackageNames": ["ghcr.io/immich-app/immich-*"],
      "groupName": "immich"
    },
    {
      "description": "Database major upgrades need a dump/restore or migration; never propose them automatically",
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres",
        "mysql",
        "mariadb",
        "mongo",
        "docker.io/library/redis",
        "docker.io/valkey/valkey"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Low-risk patch releases merge themselves (merging to master triggers the deploy workflow)",
      "matchUpdateTypes": ["patch", "digest"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "!ghcr.io/immich-app/**",
        "!postgres",
        "!docker.io/library/postgres",
        "!mysql",
        "!mariadb",
        "!mongo"
      ],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "Group GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
